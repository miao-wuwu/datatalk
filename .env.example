# 模型服务（任意 OpenAI 兼容端点）
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=studymate-qwen
LLM_API_KEY=
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.1

# 执行护栏
MAX_ROWS=200
QUERY_TIMEOUT=8
MAX_REPAIR=2
# 语义校验开关（0=关闭，只留静态校验，用于 ablation 对照）
SEMANTIC_CHECK=1

# 多轮追问
MULTI_TURN=1
HISTORY_TURNS=3

# 数据库与表白名单（留空=库里的表全开；接生产库时收紧成只读视图）
# DATATALK_DB=data/jobs.db
# ALLOWED_TABLES=jobs_v,companies_v
